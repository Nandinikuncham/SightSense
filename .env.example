# ==============================================================================
# SIGHTSENSE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and adjust values for your environment.
# Never commit .env with real credentials to source control.
# ==============================================================================

# Application & Runtime
ENVIRONMENT=development
APP_NAME=SightSense
APP_VERSION=1.0.0
API_V1_STR=/api/v1
LOG_LEVEL=INFO
DEBUG=false
REQUEST_TIMEOUT_SECONDS=30

# Network & Security
CORS_ORIGINS=["http://localhost:3000","https://sightsense.app"]
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# AWS Settings
AWS_REGION=ap-south-1
S3_BUCKET_NAME=sightsense-uploads-dev
DYNAMODB_TABLE_NAME=sightsense-main-dev
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
EVENTBRIDGE_BUS_NAME=sightsense-bus-dev
SQS_ANALYSIS_QUEUE_URL=

# AI Model Settings
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
POLLY_DEFAULT_VOICE=Aditi
POLLY_DEFAULT_ENGINE=neural

# Limits & Throttling
MAX_UPLOAD_SIZE_BYTES=5242880
ALLOWED_MIME_TYPES=["image/jpeg","image/png","image/webp"]
RATE_LIMIT_PER_MINUTE=60
ASSIST_FRAME_THROTTLE_SECONDS=1.5

# Feature Flags / Local Adapters
# Set USE_LOCAL_ADAPTERS=true for offline/local development without AWS credentials
USE_LOCAL_ADAPTERS=true
ENABLE_BEDROCK_NARRATION=false
ENABLE_POLLY_TTS=false
